# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" para lugar nenhum público.

# --- Banco de dados (MySQL / phpMyAdmin no cPanel) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- App do Meta for Developers (produto "Instagram API with Instagram Login") ---
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://marinsta.marsdesigner.com.br/connect/callback

# Token que você escolhe (qualquer string aleatória) e cadastra no painel
# do Meta em Webhooks > Instagram, campo "Verify Token"
WEBHOOK_VERIFY_TOKEN=

# --- Login do painel (só você acessa) ---
ADMIN_USER=admin
# Gere o hash com: php bin/hash_password.php "sua-senha"
ADMIN_PASS_HASH=
# Email que recebe a senha nova quando clicar em "esqueci minha senha".
ADMIN_EMAIL=

# Deixe "0" em produção. Só use "1" temporariamente para ver o erro detalhado.
APP_DEBUG=0

# --- Busca automática de leads no CRM (API da Anthropic, com custo por uso) ---
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
